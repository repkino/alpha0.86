				{
					"eventType": "comment",
					"text": "Симплекс-шум для семьи simplex (замена Rex_Simplex). Пока simplexRun=true, обновляются два канала: simValue (increment/magnitude) и simValue2 (increment2/magnitude2). Фаза второго канала смещена на +333, чтобы каналы не шумели синхронно.",
					"background-color": [
						0.33,
						0.73,
						0.48,
						1
					]
				},
				{
					"functionName": "simplexTick",
					"functionDescription": "",
					"functionCategory": "",
					"functionReturnType": "none",
					"functionCopyPicked": false,
					"functionIsAsync": false,
					"functionParameters": [],
					"eventType": "function-block",
					"conditions": [],
					"actions": [
						{
							"type": "script",
							"language": "javascript",
							"script": [
								"// 1D-симплекс-шум: создаём один раз на всё время игры",
								"if (!globalThis._simplexNoise1D) {",
								"    globalThis._simplexNoise1D = (() => {",
								"        const P = [151,160,137,91,90,15,131,13,201,95,96,53,194,233,7,225,140,36,103,30,69,142,8,99,37,240,21,10,23,190,6,148,247,120,234,75,0,26,197,62,94,252,219,203,117,35,11,32,57,177,33,88,237,149,56,87,174,20,125,136,171,168,68,175,74,165,71,134,139,48,27,166,77,146,158,231,83,111,229,122,60,211,133,230,220,105,92,41,55,46,245,40,244,102,143,54,65,25,63,161,1,216,80,73,209,76,132,187,208,89,18,169,200,196,135,130,116,188,159,86,164,100,109,198,173,186,3,64,52,217,226,250,124,123,5,202,38,147,118,126,255,82,85,212,207,206,59,227,47,16,58,17,182,189,28,42,223,183,170,213,119,248,152,2,44,154,163,70,221,153,101,155,167,43,172,9,129,22,39,253,19,98,108,110,79,113,224,232,178,185,112,104,218,246,97,228,251,34,242,193,238,210,144,12,191,179,162,241,81,51,145,235,249,14,239,107,49,192,214,31,181,199,106,157,184,84,204,176,115,121,50,45,127,4,150,254,138,236,205,93,222,114,67,29,24,72,243,141,128,195,78,66,215,61,156,180];",
								"        function grad1(hash, x) {",
								"            const h = hash & 15;",
								"            let g = 1 + (h & 7);",
								"            if (h & 8) g = -g;",
								"            return g * x;",
								"        }",
								"        return function noise(x) {",
								"            const i0 = Math.floor(x);",
								"            const i1 = i0 + 1;",
								"            const x0 = x - i0;",
								"            const x1 = x0 - 1;",
								"            let t0 = 1 - x0 * x0;",
								"            t0 *= t0;",
								"            const n0 = t0 * t0 * grad1(P[i0 & 255], x0);",
								"            let t1 = 1 - x1 * x1;",
								"            t1 *= t1;",
								"            const n1 = t1 * t1 * grad1(P[i1 & 255], x1);",
								"            return 0.395 * (n0 + n1);",
								"        };",
								"    })();",
								"}",
								"const noise1D = globalThis._simplexNoise1D;",
								"const dt = runtime.dt;",
								"if (dt <= 0) return;",
								"const phase = globalThis._simplexPhase || (globalThis._simplexPhase = {});",
								"const phase2 = globalThis._simplexPhase2 || (globalThis._simplexPhase2 = {});",
								"for (const o of runtime.objects.simplex.getAllInstances()) {",
								"    if (!o.instVars.simplexRun) continue;",
								"",
								"    // Канал 1",
								"    let p = phase[o.uid];",
								"    if (p === undefined) p = o.uid % 997;",
								"    p += o.instVars.increment * dt;",
								"    phase[o.uid] = p;",
								"    o.instVars.simValue = noise1D(p) * o.instVars.magnitude;",
								"",
								"    // Канал 2 (смещённая фаза +333, свой increment2/magnitude2)",
								"    let p2 = phase2[o.uid];",
								"    if (p2 === undefined) p2 = (o.uid % 997) + 333;",
								"    p2 += o.instVars.increment2 * dt;",
								"    phase2[o.uid] = p2;",
								"    o.instVars.simValue2 = noise1D(p2) * o.instVars.magnitude2;",
								"}"
							]
						}
					],
					"sid": 725211630683843
				},
